---
import "../styles/global.css";
import { productionIndexing } from "../release";

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialCardUrl = new URL("/social-card.svg", Astro.site);
const robots = productionIndexing && indexable ? "index,follow" : "noindex,nofollow";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialCardUrl} />
    <meta
      property="og:image:alt"
      content="Muhammad Haziq Aiman Anuar, software engineer in Kuala Terengganu, Malaysia."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCardUrl} />
    <meta
      name="twitter:image:alt"
      content="Muhammad Haziq Aiman Anuar, software engineer in Kuala Terengganu, Malaysia."
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
