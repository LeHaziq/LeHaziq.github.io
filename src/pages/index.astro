---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { selectPublishedProjects } from "../content/project-schema";
import type { PublishedProject } from "../content/project-schema";

const title = "Muhammad Haziq Aiman Anuar | Software Engineer";
const description =
  "Software engineer building secure web systems, with research experience in AI and computer vision. Explore MyConference and academic projects.";
const resumePath = "/Muhammad_Haziq_Aiman_Anuar_Resume_2026-7-26.pdf";
const projects = selectPublishedProjects(await getCollection("projects"));
type FeaturedProject = Extract<PublishedProject, { projectType: "featured" }>;
type FeaturedBlock = FeaturedProject["blocks"][number];
type FeaturedEvidence = FeaturedProject["evidence"][number];
type NarrativeBlock = Extract<FeaturedBlock, { type: "narrative" }>;
type WorkflowBlock = Extract<FeaturedBlock, { type: "workflow" }>;
type RenderedFeaturedBlock =
  | {
      type: "narrative";
      project: FeaturedProject;
      block: NarrativeBlock;
      evidence: Array<FeaturedEvidence | undefined>;
    }
  | {
      type: "workflow";
      project: FeaturedProject;
      block: WorkflowBlock;
      evidence: Array<FeaturedEvidence | undefined>;
    };

const renderedFeaturedBlocks: RenderedFeaturedBlock[] = [];
for (const project of projects) {
  if (project.projectType !== "featured") {
    continue;
  }

  const evidenceById = new Map(
    project.evidence.map((evidence) => [evidence.id, evidence]),
  );

  for (const block of project.blocks) {
    if (block.type === "narrative") {
      renderedFeaturedBlocks.push({
        type: "narrative",
        project,
        block,
        evidence: block.evidenceReferences.map((evidenceId) =>
          evidenceById.get(evidenceId),
        ),
      });
    }

    if (block.type === "workflow") {
      renderedFeaturedBlocks.push({
        type: "workflow",
        project,
        block,
        evidence: block.stepEvidenceReferences.map((evidenceId) =>
          evidenceById.get(evidenceId),
        ),
      });
    }
  }
}
const academicProjects = projects.filter(
  (project) => project.projectType === "academic",
);
const chronologyGroups = [
  {
    id: "experience",
    heading: "Experience",
    entries: [
      {
        title: "Research Assistant",
        organization: "Universiti Teknologi MARA (UiTM)",
        dates: "Nov 2024 – Mar 2026",
        location: "Shah Alam, Selangor",
        description:
          "Machine learning, deep learning, and computer-vision research; CNN and transformer testing; research or technical writing.",
      },
      {
        title: "Software Engineer (On-the-Job Trainee)",
        organization: "TalentLabs / Mysoftcare",
        dates: "Jul 2024 – Nov 2024",
        location: "Kuala Terengganu, Terengganu",
        description:
          "Laravel application development and maintenance; feature work, interface updates, and issue diagnosis.",
      },
      {
        title: "System Engineer Intern",
        organization: "Kesatuan Kakitangan Akademik UiTM (MITASA)",
        dates: "Mar 2024 – Jun 2024",
        location: "Shah Alam, Selangor",
        description:
          "Django and MySQL claim-management system using Python, Django, HTML, CSS, JavaScript, and Bootstrap, including testing, debugging, and deployment.",
      },
    ],
  },
  {
    id: "education",
    heading: "Education",
    entries: [
      {
        title: "Master of Science in Computer Science",
        organization: "Universiti Teknologi MARA (UiTM)",
        dates: "2024 – Present",
        location: "Shah Alam, Selangor",
        description: null,
      },
      {
        title:
          "BSc (Hons.) Information Systems — Intelligent Systems Engineering",
        organization: "Universiti Teknologi MARA (UiTM)",
        dates: "2022 – 2024",
        location: "Shah Alam, Selangor",
        description: null,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <header class="site-header">
    <a class="site-name" href="/">Muhammad Haziq Aiman Anuar</a>
    <nav aria-label="Primary">
      <a href="mailto:haziqaimanfb@gmail.com">Contact</a>
      <a href={resumePath} download>Resume</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="introduction-section" aria-labelledby="introduction-heading">
      <p class="eyebrow">Software engineer · Kuala Terengganu, Malaysia</p>
      <h1 id="introduction-heading">Muhammad Haziq Aiman Anuar</h1>
      <p class="introduction">
        I build secure, production-oriented web systems, with applied AI and computer
        vision as a second field of work.
      </p>
      <div class="actions">
        <a class="primary-action" href="mailto:haziqaimanfb@gmail.com">Contact me</a>
        <a href={resumePath} download>Download resume</a>
      </div>
    </section>

    {renderedFeaturedBlocks.map((pass) => pass.type === "narrative" ? (
        <section
          id={pass.project.projectSlug}
          class="featured-project-pass"
          aria-labelledby={`${pass.project.projectSlug}-ownership-heading`}
        >
          <header class="featured-pass-heading">
            <h2 id={`${pass.project.projectSlug}-ownership-heading`}>
              {pass.block.heading}
            </h2>
            <p>{pass.project.contextLabel}</p>
          </header>

          <ol class="featured-evidence-list">
            {pass.evidence.map((record) => record && (
              <li id={`${pass.project.projectSlug}-evidence-${record.id}`}>
                <p class="verified-fact-label">Verified fact</p>
                <p class="featured-claim">{record.publicClaim}</p>
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <section
          id={`${pass.project.projectSlug}-workflow`}
          class="featured-workflow-pass"
          aria-labelledby={`${pass.project.projectSlug}-workflow-heading`}
        >
          <header class="featured-pass-heading workflow-pass-heading">
            <h2 id={`${pass.project.projectSlug}-workflow-heading`}>
              {pass.block.heading}
            </h2>
            <p>{pass.project.contextLabel}</p>
          </header>

          <ol class="workflow-list">
            {pass.evidence.map((record) => record && (
              <li id={`${pass.project.projectSlug}-evidence-${record.id}`}>
                <div>
                  <h3>{record.publicCaption}</h3>
                  <p>{record.publicClaim}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

    {academicProjects.length > 0 && (
      <section class="academic-projects" aria-labelledby="academic-projects-heading">
        <header class="section-heading">
          <h2 id="academic-projects-heading">Academic projects</h2>
          <p>Applied AI and computer vision work completed at UiTM.</p>
        </header>

        <div class="academic-project-list">
          {academicProjects.map((project) => (
            <article class="academic-project">
              <p class="project-type">Academic project</p>
              <h3>{project.title}</h3>
              <p class="project-context">{project.contextLabel}</p>
              <dl class="academic-project-details">
                <div>
                  <dt>Problem</dt>
                  <dd>{project.academic.problem}</dd>
                </div>
                <div>
                  <dt>Approach</dt>
                  <dd>{project.academic.approach}</dd>
                </div>
                <div class="project-outcome">
                  <dt>Outcome</dt>
                  <dd>{project.academic.outcome}</dd>
                </div>
              </dl>
              <ul class="project-technologies" aria-label="Technologies">
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="chronology" aria-labelledby="experience-education-heading">
      <header class="section-heading">
        <h2 id="experience-education-heading">Experience &amp; education</h2>
        <p>Selected roles and study following the project evidence.</p>
      </header>

      <div class="chronology-groups">
        {chronologyGroups.map((group) => (
          <section
            class="chronology-group"
            aria-labelledby={`${group.id}-heading`}
          >
            <h3 id={`${group.id}-heading`}>{group.heading}</h3>
            <ol class="chronology-list">
              {group.entries.map((entry) => (
                <li>
                  <article>
                    <h4>{entry.title}</h4>
                    <p class="chronology-organization">{entry.organization}</p>
                    <p class="chronology-meta">
                      <span>{entry.dates}</span>
                      <span>{entry.location}</span>
                    </p>
                    {entry.description && (
                      <p class="chronology-description">{entry.description}</p>
                    )}
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
